{
  "name": "genuinefan-player-desktop",
  "productName": "GenuineFan Player",
  "version": "1.5.1",
  "description": "GenuineFan Player: a private GenuineFan experiment, inspired by Musike (MIT) by Ernani1234.",
  "author": "GenuineFan (inspired by Musike by Ernani Neto)",
  "homepage": "https://github.com/michaeljgilmore/genuinefan-player",
  "desktopName": "genuinefan-player.desktop",
  "private": true,
  "main": "dist/main.mjs",
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "start": "pnpm --filter @genuinefan-player/web build && node scripts/bundle.mjs && electron .",
    "dist": "pnpm --filter @genuinefan-player/web build && node scripts/bundle.mjs && electron-builder --win nsis --publish never",
    "dist:mac": "pnpm --filter @genuinefan-player/web build && node scripts/bundle.mjs && electron-builder --mac --publish never",
    "dist:linux": "pnpm --filter @genuinefan-player/web build && node scripts/bundle.mjs && electron-builder --linux --publish never",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "vip.genuinefan.player.desktop",
    "productName": "GenuineFan Player",
    "copyright": "Copyright (c) 2026 Ernani Neto (Musike, MIT license). Modified as GenuineFan Player.",
    "directories": {
      "output": "out",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      }
    ],
    "artifactBuildCompleted": "build/collect.cjs",
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "GenuineFan-Player-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.music",
      "minimumSystemVersion": "12.0",
      "darkModeSupport": true,
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "executableName": "genuinefan-player",
      "syncDesktopName": true,
      "category": "AudioVideo",
      "synopsis": "GenuineFan Player (private experiment).",
      "description": "GenuineFan Player: a private, non-commercial GenuineFan experiment, inspired by Musike (MIT).",
      "maintainer": "GenuineFan Player <https://github.com/michaeljgilmore/genuinefan-player>"
    },
    "deb": {
      "packageName": "genuinefan-player"
    },
    "dmg": {
      "title": "GenuineFan Player ${version}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "GenuineFan Player",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerLanguages": [
        "en_US",
        "pt_BR"
      ],
      "language": "1033",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2"
  }
}
